# Copy to `.env` and adjust. `.env` is git-ignored; never commit real keys.

# LLM provider: "auto" (anthropic if a key is set, otherwise the offline fake), "anthropic" or "fake"
EHR_LLM_PROVIDER=auto
ANTHROPIC_API_KEY=
EHR_LLM_MODEL=claude-haiku-5-5

# Embeddings (sentence-transformers model id)
EHR_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Where pipeline outputs (SQLite, Chroma, reports) are written
# EHR_DATA_DIR=data/runtime
